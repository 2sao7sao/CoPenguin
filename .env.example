# Server
HOST=127.0.0.1
PORT=8787
COPENGUIN_DATA_DIR=.copenguin

# Feishu app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_BOT_OPEN_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Owner allowlist. Keep TRUST_ALL disabled outside local parser tests.
FEISHU_ALLOWED_OPEN_IDS=ou_xxx
FEISHU_ALLOWED_UNION_IDS=
TRUST_ALL_FEISHU_USERS_FOR_DEV=0
FEISHU_REQUIRE_GROUP_MENTION=1

# Task approval
APPROVAL_REQUIRED=1
APPROVAL_TTL_SECONDS=1800

# Computer provider
COMPUTER_PROVIDER=dry-run
LOCAL_SHELL_ENABLED=0
LOCAL_SHELL_ALLOWLIST=pwd,ls,date,whoami
LOCAL_SHELL_TIMEOUT_SECONDS=20

# Evolve integrations
MEMORY_ENABLED=1
KNOWLEDGE_ENABLED=1
KB_ROOT=kb
